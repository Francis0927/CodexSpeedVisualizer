{
  "name": "codex-speed-pet",
  "version": "0.5.12",
  "private": true,
  "description": "A local Codex token speed car dashboard",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/usage.test.cjs tests/topmost.test.cjs tests/release.test.cjs tests/release-actions.test.cjs tests/prune-local.test.cjs tests/update.test.cjs tests/main.test.cjs",
    "dist:portable": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "dist": "npm run build && electron-builder --win nsis && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prune-local-releases.ps1 -Mode Installer",
    "prune:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prune-local-releases.ps1",
    "publish:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-github.ps1",
    "test:window": "npm run build && electron tests/window.test.cjs",
    "test:update-window": "npm run build && electron tests/update-window.test.cjs",
    "test:topmost": "electron tests/topmost-window.test.cjs",
    "dist:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "rcedit": "4.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "dev.codex.speedpet",
    "productName": "Codex Speed Pet",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/update-share*.json",
      "assets/**/*",
      "package.json"
    ],
    "afterPack": "scripts/set-executable-icon.cjs",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
